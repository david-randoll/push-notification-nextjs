# use command `web-push generate-vapid-keys --json` to generate a new key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFICATION_URL=http://localhost:3000/

# Optional, dev only. To open the dev server from another device on your LAN, set this to
# this machine's LAN address so Next allows cross-origin dev requests, e.g. 192.168.1.10
DEV_ORIGIN=
